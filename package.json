{
  "name": "automationexercise-pom-framework",
  "version": "1.0.0",
  "description": "Playwright + TypeScript Page Object Model framework for https://automationexercise.com covering all 26 documented test cases",
  "private": true,
  "scripts": {
    "postinstall": "playwright install --with-deps chromium firefox webkit msedge",
    "test": "cucumber-js",
    "cucumber": "cucumber-js",
    "cucumber:headed": "cross-env HEADLESS=false cucumber-js",
    "cucumber:headed:smoke": "cross-env HEADLESS=false cucumber-js --tags @smoke",
    "cucumber:headed:regression": "cross-env HEADLESS=false cucumber-js --tags @regression",
    "cucumber:smoke": "cucumber-js --tags @smoke",
    "cucumber:regression": "cucumber-js --tags @regression",
    "cucumber:auth": "cucumber-js --tags @auth",
    "cucumber:cart": "cucumber-js --tags @cart",
    "cucumber:checkout": "cucumber-js --tags @checkout",
    "cucumber:chromium": "cross-env BROWSER=chromium cucumber-js",
    "cucumber:firefox": "cross-env BROWSER=firefox cucumber-js",
    "cucumber:webkit": "cross-env BROWSER=webkit cucumber-js",
    "cucumber:edge": "cross-env BROWSER=edge cucumber-js",
    "cucumber:mobile": "cross-env DEVICE=\"Pixel 7\" cucumber-js",
    "cucumber:parallel": "cross-env WORKERS=4 cucumber-js",
    "cucumber:cross-browser": "node scripts/run-cross-browser.js",
    "cucumber:cross-browser:smoke": "node scripts/run-cross-browser.js --tags @smoke",
    "cucumber:cross-browser:regression": "node scripts/run-cross-browser.js --tags @regression",
    "playwright": "playwright test",
    "playwright:headed": "playwright test --headed",
    "playwright:debug": "playwright test --debug",
    "playwright:smoke": "playwright test --grep @smoke",
    "playwright:regression": "playwright test --grep @regression",
    "report": "playwright show-report reports/html",
    "trace": "playwright show-trace",
    "allure:generate": "allure generate allure-results --clean -o reports/allure",
    "allure:open": "allure open reports/allure",
    "allure:serve": "allure serve allure-results",
    "cucumber:allure:generate": "allure generate allure-results/cucumber --clean -o reports/allure/cucumber",
    "cucumber:allure:open": "allure open reports/allure/cucumber",
    "cucumber:allure:serve": "allure serve allure-results/cucumber",
    "cucumber:allure:reset": "rimraf allure-results/cucumber && node -e \"require('fs').mkdirSync('allure-results/cucumber',{recursive:true})\"",
    "codegen": "playwright codegen https://automationexercise.com",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf reports test-results allure-results"
  },
  "keywords": [
    "playwright",
    "typescript",
    "pom",
    "qa",
    "automation"
  ],
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@faker-js/faker": "^9.0.3",
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.7.5",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "allure-commandline": "^2.43.0",
    "allure-cucumberjs": "^3.10.2",
    "allure-playwright": "^3.10.2",
    "cross-env": "^10.1.0",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.1",
    "eslint-plugin-playwright": "^1.6.2",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
