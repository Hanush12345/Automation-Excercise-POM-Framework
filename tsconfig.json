{
  "ts-node": {
    "transpileOnly": true
  },
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "paths": {
      "@pages/*": ["./pages/*"],
      "@components": ["./pages/components"],
      "@fixtures/*": ["./src/fixtures/*"],
      "@flows/*": ["./src/flows/*"],
      "@utils/*": ["./src/utils/*"],
      "@data/*": ["./src/data/*"],
      "@types/*": ["./src/types/*"],
      "@config/*": ["./src/config/*"]
    }
  },
  "include": ["src/**/*.ts", "pages/**/*.ts", "step_definitions/**/*.ts", "support/**/*.ts", "playwright.config.ts"],
  "exclude": ["node_modules", "reports", "test-results"]
}